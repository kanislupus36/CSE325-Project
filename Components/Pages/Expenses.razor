
@page "/expenses"
@rendermode InteractiveServer
@using System.Security.Claims
@using ExpenseTracker.Data
@using ExpenseTracker.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Expenses</PageTitle>

<main id="main-content">
<h1>My Expenses</h1>
<p>Track and manage your personal spending.</p>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Spent This Month</h2>
                @if (expenses is null)
                {
                    <p role="status">Loading...</p>
                }
                else
                {
                    <p class="display-6 mb-0">
                        @MonthlyTotal.ToString("C")
                    </p>
                    <p class="text-muted mb-0">
                        @MonthlyExpenseCount expenses this month
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Categories This Month</h2>
                @if (expenses is null)
                {
                    <p role="status">Loading...</p>
                }
                else if (!CategoryTotals.Any())
                {
                    <p class="text-muted mb-0">
                        No expenses recorded this month yet.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in CategoryTotals)
                        {
                            <li class="list-group-item d-flex
                                       justify-content-between px-0">
                                <span>@item.Category</span>
                                <strong>@item.Total.ToString("C")</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>


@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info" role="status">@message</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h4">Add an Expense</h2>

        <EditForm Model="@newExpense"
          OnValidSubmit="@AddExpenseAsync"
          FormName="AddExpense">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="description" class="form-label">
                    Description
                </label>
                <InputText id="description"
                           class="form-control"
                           @bind-Value="newExpense.Description" />
                <ValidationMessage For="@(() => newExpense.Description)" />
            </div>

            <div class="mb-3">
                <label for="amount" class="form-label">Amount ($)</label>
                <InputNumber id="amount"
                             class="form-control"
                             @bind-Value="newExpense.Amount"
                             step="0.01" />
                <ValidationMessage For="@(() => newExpense.Amount)" />
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <InputSelect id="category"
                             class="form-select"
                             @bind-Value="newExpense.Category">
                    <option value="">Select a category</option>
                    <option value="Food">Food</option>
                    <option value="Transportation">Transportation</option>
                    <option value="Bills">Bills</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Shopping">Shopping</option>
                    <option value="School">School</option>
                    <option value="Other">Other</option>
                </InputSelect>
                <ValidationMessage For="@(() => newExpense.Category)" />
            </div>

            <div class="mb-3">
                <label for="date" class="form-label">Date</label>
                <InputDate id="date"
                           class="form-control"
                           @bind-Value="newExpense.Date" />
                <ValidationMessage For="@(() => newExpense.Date)" />
            </div>

            <div class="mb-3">
                <label for="notes" class="form-label">
                    Notes (optional)
                </label>
                <InputTextArea id="notes"
                               class="form-control"
                               @bind-Value="newExpense.Notes" />
            </div>

            <button type="submit" class="btn btn-primary">
                Add Expense
            </button>
        </EditForm>
    </div>
</div>


@if (editingExpense is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h4">Edit Expense</h2>

            <EditForm Model="@editingExpense"
                      OnValidSubmit="@SaveEditedExpenseAsync"
                      FormName="EditExpense">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="edit-description" class="form-label">
                        Description
                    </label>
                    <InputText id="edit-description"
                               class="form-control"
                               @bind-Value="editingExpense.Description" />
                    <ValidationMessage
                        For="@(() => editingExpense.Description)" />
                </div>

                <div class="mb-3">
                    <label for="edit-amount" class="form-label">
                        Amount ($)
                    </label>
                    <InputNumber id="edit-amount"
                                 class="form-control"
                                 @bind-Value="editingExpense.Amount"
                                 step="0.01" />
                    <ValidationMessage
                        For="@(() => editingExpense.Amount)" />
                </div>

                <div class="mb-3">
                    <label for="edit-category" class="form-label">
                        Category
                    </label>
                    <InputSelect id="edit-category"
                                 class="form-select"
                                 @bind-Value="editingExpense.Category">
                        <option value="">Select a category</option>
                        <option value="Food">Food</option>
                        <option value="Transportation">Transportation</option>
                        <option value="Bills">Bills</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Shopping">Shopping</option>
                        <option value="School">School</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                    <ValidationMessage
                        For="@(() => editingExpense.Category)" />
                </div>

                <div class="mb-3">
                    <label for="edit-date" class="form-label">Date</label>
                    <InputDate id="edit-date"
                               class="form-control"
                               @bind-Value="editingExpense.Date" />
                    <ValidationMessage
                        For="@(() => editingExpense.Date)" />
                </div>

                <div class="mb-3">
                    <label for="edit-notes" class="form-label">
                        Notes (optional)
                    </label>
                    <InputTextArea id="edit-notes"
                                   class="form-control"
                                   @bind-Value="editingExpense.Notes" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        @onclick="CancelEditing">
                    Cancel
                </button>
            </EditForm>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <h2 class="h4">Expense History</h2>
        
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <label for="search-expenses" class="form-label">
            Search description
        </label>
        <InputText id="search-expenses"
                   class="form-control"
                   @bind-Value="searchText" />
    </div>

    <div class="col-12 col-md-6">
        <label for="filter-category" class="form-label">
            Filter by category
        </label>
        <InputSelect id="filter-category"
                     class="form-select"
                     @bind-Value="selectedCategory">
            <option value="">All categories</option>
            <option value="Food">Food</option>
            <option value="Transportation">Transportation</option>
            <option value="Bills">Bills</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Shopping">Shopping</option>
            <option value="School">School</option>
            <option value="Other">Other</option>
        </InputSelect>
    </div>

    <div class="col-12 col-md-6">
        <label for="start-date" class="form-label">
            From date
        </label>
        <InputDate id="start-date"
                   class="form-control"
                   @bind-Value="startDate" />
    </div>

    <div class="col-12 col-md-6">
        <label for="end-date" class="form-label">
            To date
        </label>
        <InputDate id="end-date"
                   class="form-control"
                   @bind-Value="endDate" />
                   @if (DateRangeError is not null)
{
    <div class="col-12">
        <div class="alert alert-danger" role="alert">
            @DateRangeError
        </div>
    </div>
}
    </div>

    <div class="col-12">
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="ClearFilters">
            Clear Filters
        </button>
    </div>
</div>

@if (DateRangeError is null)
{
    <p role="status">
        Showing @FilteredExpenses.Count() of @(expenses?.Count ?? 0) expenses.
    </p>
}


        @if (expenses is null)
        {
            <p role="status">Loading expenses...</p>
        }
        else if (!FilteredExpenses.Any())
        {
            <p>No expenses match your search or filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <caption>Your recorded expenses</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Description</th>
                            <th scope="col">Category</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in FilteredExpenses)
                        {
                            <tr @key="expense.Id">
                                <td>@expense.Date.ToString("MMM d, yyyy")</td>
                                <td>
                                    @expense.Description
                                    @if (!string.IsNullOrWhiteSpace(expense.Notes))
                                    {
                                        <div class="text-muted small">
                                            @expense.Notes
                                        </div>
                                    }
                                </td>
                                <td>@expense.Category</td>
                                <td>@expense.Amount.ToString("C")</td>
                               <td>
    <button type="button"
            class="btn btn-outline-primary btn-sm me-2"
            @onclick="() => StartEditing(expense)">
        Edit
        <span class="visually-hidden">
            @expense.Description
        </span>
    </button>

    <button type="button"
            class="btn btn-outline-danger btn-sm"
            @onclick="() => DeleteExpenseAsync(expense.Id)">
        Delete
        <span class="visually-hidden">
            @expense.Description
        </span>
    </button>
</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
</main>

@code {
   private Expense newExpense = new();
private Expense? editingExpense;
private List<Expense>? expenses;
private string? userId;
private string? message;
private decimal MonthlyTotal =>
    expenses?
        .Where(e => e.Date.Year == DateTime.Today.Year
                 && e.Date.Month == DateTime.Today.Month)
        .Sum(e => e.Amount) ?? 0m;

private int MonthlyExpenseCount =>
    expenses?
        .Count(e => e.Date.Year == DateTime.Today.Year
                 && e.Date.Month == DateTime.Today.Month) ?? 0;

private IEnumerable<(string Category, decimal Total)> CategoryTotals =>
    expenses?
        .Where(e => e.Date.Year == DateTime.Today.Year
                 && e.Date.Month == DateTime.Today.Month)
        .GroupBy(e => e.Category)
        .Select(g => (Category: g.Key, Total: g.Sum(e => e.Amount)))
        .OrderByDescending(g => g.Total)
    ?? Enumerable.Empty<(string Category, decimal Total)>();

    private string searchText = "";
private string selectedCategory = "";
private DateTime? startDate;
private DateTime? endDate;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        await LoadExpensesAsync();
    }

    private async Task LoadExpensesAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        expenses = await db.Expenses
            .AsNoTracking()
            .Where(e => e.UserId == userId)
            .OrderByDescending(e => e.Date)
            .ThenByDescending(e => e.Id)
            .ToListAsync();
    }

    private async Task AddExpenseAsync()
    {
        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        // Assign ownership on the server, never from form input.
        newExpense.UserId = userId;

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        db.Expenses.Add(newExpense);
        await db.SaveChangesAsync();

        newExpense = new Expense();
        message = "Expense added successfully.";

        await LoadExpensesAsync();
    }

    private async Task DeleteExpenseAsync(int id)
    {
        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        // Only find an expense owned by the signed-in user.
        var expense = await db.Expenses
            .FirstOrDefaultAsync(e => e.Id == id && e.UserId == userId);

        if (expense is null)
        {
            message = "Expense not found.";
            return;
        }

        db.Expenses.Remove(expense);
        await db.SaveChangesAsync();

        message = "Expense deleted successfully.";
        await LoadExpensesAsync();
    }

    
private void StartEditing(Expense expense)
{
    // Make a copy so canceling doesn't change the displayed expense.
    editingExpense = new Expense
    {
        Id = expense.Id,
        UserId = expense.UserId,
        Description = expense.Description,
        Amount = expense.Amount,
        Category = expense.Category,
        Date = expense.Date,
        Notes = expense.Notes
    };

    message = null;
}

private async Task SaveEditedExpenseAsync()
{
    if (editingExpense is null || string.IsNullOrEmpty(userId))
    {
        return;
    }

    using var scope = ScopeFactory.CreateScope();
    var db = scope.ServiceProvider
        .GetRequiredService<ApplicationDbContext>();

    // Only update an expense belonging to the signed-in user.
    var expense = await db.Expenses
        .FirstOrDefaultAsync(e =>
            e.Id == editingExpense.Id && e.UserId == userId);

    if (expense is null)
    {
        editingExpense = null;
        message = "Expense not found.";
        await LoadExpensesAsync();
        return;
    }

    expense.Description = editingExpense.Description;
    expense.Amount = editingExpense.Amount;
    expense.Category = editingExpense.Category;
    expense.Date = editingExpense.Date;
    expense.Notes = editingExpense.Notes;

    await db.SaveChangesAsync();

    editingExpense = null;
    message = "Expense updated successfully.";

    await LoadExpensesAsync();
}

private void CancelEditing()
{
    editingExpense = null;
    message = null;
}

private void ClearFilters()
{
    searchText = "";
    selectedCategory = "";
    startDate = null;
    endDate = null;
}

private string? DateRangeError =>
    startDate.HasValue &&
    endDate.HasValue &&
    startDate.Value.Date > endDate.Value.Date
        ? "The start date must be on or before the end date."
        : null;

private IEnumerable<Expense> FilteredExpenses =>
    startDate.HasValue &&
    endDate.HasValue &&
    startDate.Value.Date > endDate.Value.Date
        ? Enumerable.Empty<Expense>()
        : (expenses ?? new List<Expense>())
            .Where(e =>
                string.IsNullOrWhiteSpace(searchText) ||
                e.Description.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase))
            .Where(e =>
                string.IsNullOrEmpty(selectedCategory) ||
                e.Category == selectedCategory)
            .Where(e =>
                !startDate.HasValue ||
                e.Date.Date >= startDate.Value.Date)
            .Where(e =>
                !endDate.HasValue ||
                e.Date.Date <= endDate.Value.Date)
            .OrderByDescending(e => e.Date)
            .ThenByDescending(e => e.Id);

}
